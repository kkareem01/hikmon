# Local Service Marketers onboarding pipeline — environment variables
# Copy to .env for local `vercel dev`; set the real values in Vercel project settings.

# --- Stripe ---
# Secret key from https://dashboard.stripe.com/apikeys (use sk_test_... locally)
STRIPE_SECRET_KEY=sk_live_xxx

# --- Airtable ---
# Personal access token from https://airtable.com/create/tokens
# (scopes: data.records:read, data.records:write — on the onboarding base)
AIRTABLE_API_KEY=patxxx
AIRTABLE_BASE_ID=appxxx
AIRTABLE_TABLE_NAME=Clients
AIRTABLE_FAILED_TABLE_NAME=FailedSubmissions

# --- Resend ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# Verified sending address (domain must be verified in Resend)
FROM_EMAIL=kareem@localservicemarketers.com
# Where the internal new-client notification is sent
KAREEM_EMAIL=kareem@localservicemarketers.com

# --- Cloudinary (used client-side; cloud name + preset are public, no secret) ---
CLOUDINARY_CLOUD_NAME=lsm
CLOUDINARY_UPLOAD_PRESET=lsm_onboarding_unsigned

# --- Site ---
# Public origin, used to build Stripe/Airtable deep links in emails
SITE_ORIGIN=https://localservicemarketers.com

# --- Booking system (strategy-call scheduler) ---
# Database: libSQL/Turso. Local dev uses a SQLite file; production uses Turso.
#   Local:      TURSO_DATABASE_URL=file:local.db   (no auth token)
#   Production: TURSO_DATABASE_URL=libsql://<db>.turso.io  + TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
# Booking confirmation emails reuse RESEND_API_KEY + FROM_EMAIL above.
# Owner notification recipient (defaults to KAREEM_EMAIL/FROM_EMAIL if unset):
OWNER_EMAIL=kareem@localservicemarketers.com
BUSINESS_NAME=Local Service Marketers
# Local QA: write emails to tmp/ instead of sending (set true locally, unset in prod)
DRY_RUN_EMAIL=true
